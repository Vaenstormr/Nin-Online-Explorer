<Window x:Class="Nin_Online_Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Nin_Online_Explorer"
        Title="Nin Online Explorer"
        Height="600" Width="1000"
        Background="#1E1E1E">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#3D3D3D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- LEFT PANE-->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="BtnSelectFolder" 
                    Grid.Row="0"
                    Content="Select Assets Folder" 
                    Foreground="White" 
                    FontSize="14"
                    Padding="10,8" 
                    Margin="0,0,0,10"
                    VerticalAlignment="Top"
                    Click="BtnSelectFolder_Click" FontWeight="Bold">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#3D3D3D"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="0" 
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#4D4D4D"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <!-- ACTION BUTTONS -->
            <UniformGrid Grid.Row="1" Columns="3" Rows="1" Margin="0,6,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Button x:Name="BtnExportPng" 
                        Content="Export" 
                        Padding="20,10"
                        FontWeight="Bold"
                        Click="BtnExportPng_Click"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0" Foreground="#FFFF333C" BorderBrush="#FFFF333C"/>
                <Button x:Name="BtnImportFromFile"
                        Content="Import"
                        Click="BtnImportFromFile_Click"
                        Style="{StaticResource ActionButtonStyle}" FontWeight="Bold" BorderBrush="#FFFF333C" Foreground="#FFFF333C" Margin="0,0,8,0"/>
                <Button x:Name="BtnSmartBatchReplace" 
                        Content="Batch Replace" 
                        Click="BtnSmartBatchReplace_Click"
                        Style="{StaticResource ActionButtonStyle}" FontWeight="Bold" BorderBrush="#FFFF333C" Foreground="#FFFF333C"/>
            </UniformGrid>
            <TreeView x:Name="TreeFolderStructure" 
                      Grid.Row="2"
                      Background="#2D2D2D" 
                      BorderThickness="0"
                      FontSize="14" 
                      FontFamily="Segoe UI"
                      TreeViewItem.Selected="TreeViewItem_OnSelected">
                <TreeView.Resources>
                    <local:FileToIconConverter x:Key="FileIconConverter"/>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="#AAAAAA"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="SelectionBorder" 
                                                Background="{TemplateBinding Background}" 
                                                Padding="5,2"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="TypeIcon" 
                                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource FileIconConverter}}" 
                                                           Margin="0,0,8,0" 
                                                           VerticalAlignment="Center"/>
                                                <ContentPresenter x:Name="PART_Header" 
                                                                  ContentSource="Header" 
                                                                  VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Header, Converter={StaticResource FileIconConverter}}" Value="📁">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="Background" Value="#3A3A3A"/>
                                            <Setter Property="Foreground" Value="#00A2E8"/>
                                        </Trigger>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </Grid>
        <!-- RIGHT PANE -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#111111" CornerRadius="5">
                <Image x:Name="ImagePreview" 
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>
            <TextBlock Grid.Column="1" 
           Foreground="#444444" 
           FontSize="10" 
           Margin="0,0,10,5"
           VerticalAlignment="Bottom" 
           HorizontalAlignment="Right">
    <Hyperlink NavigateUri="https://github.com/Vaenstormr/Nin-Online-Explorer" 
               RequestNavigate="Hyperlink_RequestNavigate"
               Foreground="#00A2E8"
               FontWeight="Bold"
               TextDecorations="None">
        <Run Text="Nin Online Explorer"/>
    </Hyperlink>
    <Run Text=" | by Vaenstormr"/>
            </TextBlock>
        </Grid>
    </Grid>
</Window>